# MT5 Sync Production Settings
# Add these to your .env file to optimize for production without timeouts

# Reduce batch sizes to prevent MT5 overload
SYNC_ALL_BATCH_SIZE=1
SYNC_ALL_MAX_CONCURRENT=2

# Increase delays to reduce API pressure  
SYNC_ALL_BATCH_DELAY=15

# Conservative timeout settings
SYNC_ALL_CONNECTION_TIMEOUT=180
SYNC_ALL_JOB_TIMEOUT=240
SYNC_ALL_MAX_RETRIES=2

# Rate limiting - longer random delays
SYNC_ALL_RANDOM_DELAY_MIN=3
SYNC_ALL_RANDOM_DELAY_MAX=10

# Retry configuration
SYNC_ALL_RETRY_DELAY=15
SYNC_ALL_MAX_EXCEPTIONS=2
